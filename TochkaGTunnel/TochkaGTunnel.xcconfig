HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT)/TochkaGTunnel/LibXrayStatic/Headers
OTHER_LDFLAGS = $(inherited) -L$(SRCROOT)/TochkaGTunnel/LibXrayStatic -lXray -framework Foundation -framework Security -framework CFNetwork -framework UIKit -lresolv -lc++

EXCLUDED_ARCHS[sdk=iphonesimulator*] = arm64
